# RAGX settings. Copy this file to .env and pick ONE of the free setups below.
# With no keys and no local models, RAGX still runs in OFFLINE mode
# (built-in heuristics: fine for trying the app, not for real answers).
#
# Model names change often. To see the models your key can use:
#   ragx models gemini     ragx models groq     ragx models openrouter     ragx models ollama

# =============================================================================
# SETUP A (default): Google Gemini free tier. Fast, no credit card.
# Get a free key at https://aistudio.google.com -> Get API key.
# Free tier: non-"lite" models only allow ~20 requests/day, so the lite ones are used.
# Note: on the free tier Google may use requests to improve its products.
# =============================================================================
RAGX_GEMINI_API_KEY=
RAGX_GENERATOR=gemini:gemini-3.5-flash-lite
RAGX_VERIFIER=gemini:gemini-3.1-flash-lite
RAGX_UTILITY=gemini:gemini-3.5-flash-lite
RAGX_GENERATOR_FALLBACKS=gemini:gemini-3.1-flash-lite
RAGX_VERIFIER_FALLBACKS=gemini:gemini-3.5-flash-lite
RAGX_UTILITY_FALLBACKS=gemini:gemini-3.1-flash-lite
RAGX_EMBEDDER=gemini:gemini-embedding-001

# =============================================================================
# SETUP B: fully local open-source models with Ollama. Free, private, unlimited,
# no keys. Needs ~8 GB free RAM; without a graphics card answers take 30-90 s.
#   1. Install Ollama from https://ollama.com
#   2. ollama pull qwen3:4b && ollama pull gemma3:4b && ollama pull nomic-embed-text
#   3. Replace the model lines of setup A with:
# RAGX_GENERATOR=ollama:qwen3:4b
# RAGX_VERIFIER=ollama:gemma3:4b
# RAGX_UTILITY=ollama:qwen3:4b
# RAGX_GENERATOR_FALLBACKS=
# RAGX_VERIFIER_FALLBACKS=
# RAGX_UTILITY_FALLBACKS=
# RAGX_EMBEDDER=ollama:nomic-embed-text
# Context window given to local models (more = longer documents, more RAM):
# RAGX_OLLAMA_NUM_CTX=16384
# Where Ollama runs. Docker reaches Ollama on this computer automatically; for the
# bundled container (docker compose --profile ollama up) use http://ollama:11434
# RAGX_OLLAMA_URL=http://localhost:11434

# =============================================================================
# SETUP C: mix free providers for speed + independence + more daily quota.
# Free keys: https://console.groq.com and https://openrouter.ai (use ":free" models).
# Example (check current names with `ragx models groq` / `ragx models openrouter`):
# RAGX_GROQ_API_KEY=
# RAGX_OPENROUTER_API_KEY=
# RAGX_GENERATOR=groq:llama-3.3-70b-versatile
# RAGX_VERIFIER=gemini:gemini-3.1-flash-lite
# RAGX_UTILITY=gemini:gemini-3.5-flash-lite
# RAGX_GENERATOR_FALLBACKS=openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:qwen3:4b
# =============================================================================

# Reranker: llm (uses the utility model) | lexical (built-in, no model calls)
RAGX_RERANKER=llm:utility

# Optional paid providers (not needed): anthropic:<model>, openai:<model>
# RAGX_ANTHROPIC_API_KEY=
# RAGX_OPENAI_API_KEY=
# RAGX_OPENAI_BASE_URL=https://api.openai.com/v1   # also works for LM Studio / vLLM

# --- web fallback (only used when web_fallback_enabled is turned on in Settings)
# none | tavily | brave
RAGX_WEB_SEARCH_PROVIDER=none
RAGX_TAVILY_API_KEY=
RAGX_BRAVE_API_KEY=

# --- accounts
# Emails that become administrators when they sign up or sign in (comma separated).
# Sign up on the website with this email first; everyone else becomes a student.
RAGX_ADMIN_EMAILS=
# Set to true once the site is served over HTTPS (deployment).
RAGX_COOKIE_SECURE=false

# --- automation: a service key for scripts/CI (acts as an admin via X-API-Key).
# Never put it in the browser; people sign in with accounts.
RAGX_API_KEY=

# --- background loops in seconds (0 disables)
RAGX_REPAIR_INTERVAL=1800
RAGX_CRAWL_INTERVAL=300
RAGX_CANARY_INTERVAL=600

# --- docker compose: host folder mounted read-only at /docs inside the API
RAGX_DOCS_DIR=./docs
POSTGRES_PASSWORD=ragx
