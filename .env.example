# Copy to .env and fill in. Without any keys RAGX runs in OFFLINE mode
# (deterministic heuristics: good for trying the platform, not for real answers).

# --- model roles: "provider:model" (providers: anthropic, openai, gemini, fake)
RAGX_GENERATOR=anthropic:claude-opus-5-5
RAGX_VERIFIER=gemini:gemini-2.5-pro
RAGX_UTILITY=anthropic:claude-haiku-4-5
# optional fallback chains, comma separated
RAGX_GENERATOR_FALLBACKS=openai:gpt-5
RAGX_VERIFIER_FALLBACKS=
RAGX_UTILITY_FALLBACKS=

# --- embeddings: openai:<model> | gemini:<model> | voyage:<model> | hash:hash-512 (offline)
RAGX_EMBEDDER=gemini:gemini-embedding-001
# --- reranker: cohere:<model> | voyage:<model> | llm:utility | lexical
RAGX_RERANKER=llm:utility

RAGX_ANTHROPIC_API_KEY=
RAGX_OPENAI_API_KEY=
RAGX_GEMINI_API_KEY=
RAGX_VOYAGE_API_KEY=
RAGX_COHERE_API_KEY=

# --- web fallback (only used when web_fallback_enabled is turned on in Settings)
# none | tavily | brave
RAGX_WEB_SEARCH_PROVIDER=none
RAGX_TAVILY_API_KEY=
RAGX_BRAVE_API_KEY=

# --- security: when set, every API call needs X-API-Key (the web proxy adds it)
RAGX_API_KEY=

# --- background loops in seconds (0 disables)
RAGX_REPAIR_INTERVAL=1800
RAGX_CRAWL_INTERVAL=300
RAGX_CANARY_INTERVAL=600

# --- docker compose: host folder mounted read-only at /docs inside the API
RAGX_DOCS_DIR=./docs
POSTGRES_PASSWORD=ragx
